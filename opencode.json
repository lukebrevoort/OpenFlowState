{
  "$schema": "https://opencode.ai/config.json",
  "theme": "./themes/flowstate.json",
  "mcp": {
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "environment": {
        "NOTION_TOKEN": ""
      },
      "enabled": true
    },
    "flowstate-gmail": {
      "type": "local",
      "command": ["pnpm", "--filter", "@flowstate/mcp-gmail", "start"],
      "enabled": true
    },
    "flowstate-gcal": {
      "type": "local",
      "command": ["pnpm", "--filter", "@flowstate/mcp-gcal", "start"],
      "enabled": true
    },
    "flowstate-system": {
      "type": "local",
      "command": ["pnpm", "--filter", "@flowstate/mcp-system", "start"],
      "enabled": true
    },
    "flowstate-canvas": {
      "type": "local",
      "command": ["pnpm", "--filter", "@flowstate/mcp-canvas", "start"],
      "enabled": true
    }
  }
}
