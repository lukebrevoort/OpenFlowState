{
  "name": "@flowstate/desktop",
  "version": "0.1.0",
  "description": "FlowState Desktop App - AI-powered productivity orchestration",
  "author": "Luke Brevoort",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron dist/main/index.js",
    "preview": "npm run build && npm run start",
    "prepare:opencode-binaries": "node scripts/ensure-opencode-binaries.mjs",
    "prepare:node-runtime": "node scripts/ensure-node-runtime.mjs",
    "package": "pnpm -w --filter @flowstate/core build && pnpm -w --filter @flowstate/mcp-gmail build && pnpm -w --filter @flowstate/mcp-notion build && pnpm -w --filter @flowstate/mcp-gcal build && pnpm -w --filter @flowstate/mcp-system build && pnpm -w --filter @flowstate/mcp-canvas build && npm run build && npm run prepare:opencode-binaries && npm run prepare:node-runtime && electron-builder --config electron-builder.yml",
    "package:mac": "pnpm -w --filter @flowstate/core build && pnpm -w --filter @flowstate/mcp-gmail build && pnpm -w --filter @flowstate/mcp-notion build && pnpm -w --filter @flowstate/mcp-gcal build && pnpm -w --filter @flowstate/mcp-system build && pnpm -w --filter @flowstate/mcp-canvas build && npm run build && npm run prepare:opencode-binaries && npm run prepare:node-runtime && electron-builder --mac --config electron-builder.yml",
    "clean": "rm -rf dist out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:runtime-deps": "node scripts/check-runtime-deps.mjs"
  },
  "dependencies": {
    "@flowstate/core": "workspace:*",
    "@flowstate/mcp-canvas": "workspace:*",
    "@flowstate/mcp-gcal": "workspace:*",
    "@flowstate/mcp-gmail": "workspace:*",
    "@flowstate/mcp-notion": "workspace:*",
    "@flowstate/mcp-system": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@notionhq/client": "^2.2.0",
    "@opencode-ai/sdk": "^1.1.20",
    "@xmldom/xmldom": "^0.8.10",
    "argparse": "~1.0.3",
    "better-sqlite3": "^11.10.0",
    "bignumber.js": "^9.1.2",
    "bindings": "^1.5.0",
    "bluebird": "^3.7.2",
    "dingbat-to-unicode": "^1.0.1",
    "duck": "^0.1.12",
    "ecdsa-sig-formatter": "^1.0.11",
    "electron-updater": "^6.8.3",
    "extend": "^3.0.2",
    "file-uri-to-path": "^1.0.0",
    "gaxios": "^6.7.1",
    "google-auth-library": "^9.15.1",
    "google-logging-utils": "^0.0.2",
    "googleapis": "^140.0.0",
    "googleapis-common": "^7.2.0",
    "gtoken": "^7.0.0",
    "is-stream": "^2.0.1",
    "json-bigint": "^1.0.0",
    "jszip": "^3.10.1",
    "jwa": "^2.0.1",
    "jws": "^4.0.0",
    "lop": "^0.4.2",
    "mammoth": "^1.10.0",
    "option": "~0.2.1",
    "pako": "^2.1.0",
    "path-is-absolute": "^1.0.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.58.1",
    "safe-buffer": "^5.2.1",
    "setimmediate": "^1.0.5",
    "shellwords": "^0.1.1",
    "tr46": "^0.0.3",
    "underscore": "^1.13.6",
    "url-template": "^2.0.8",
    "uuid": "^9.0.1",
    "webidl-conversions": "^3.0.1",
    "whatwg-url": "^5.0.0",
    "xmlbuilder": "^15.1.1",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.312.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.0.0",
    "zustand": "^4.5.0"
  }
}
