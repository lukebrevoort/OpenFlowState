{
  "name": "@flowstate/desktop",
  "version": "0.1.0",
  "description": "FlowState Desktop App - AI-powered productivity orchestration",
  "author": "Luke Brevoort",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron dist/main/index.js",
    "preview": "npm run build && npm run start",
    "prepare:opencode-binaries": "node scripts/ensure-opencode-binaries.mjs",
    "package": "pnpm -w --filter @flowstate/core build && pnpm -w --filter @flowstate/mcp-gmail build && pnpm -w --filter @flowstate/mcp-gcal build && pnpm -w --filter @flowstate/mcp-system build && pnpm -w --filter @flowstate/mcp-canvas build && npm run build && npm run prepare:opencode-binaries && electron-builder",
    "package:mac": "pnpm -w --filter @flowstate/core build && pnpm -w --filter @flowstate/mcp-gmail build && pnpm -w --filter @flowstate/mcp-gcal build && pnpm -w --filter @flowstate/mcp-system build && pnpm -w --filter @flowstate/mcp-canvas build && npm run build && npm run prepare:opencode-binaries && electron-builder --mac",
    "clean": "rm -rf dist out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:runtime-deps": "node scripts/check-runtime-deps.mjs"
  },
  "dependencies": {
    "@flowstate/core": "workspace:*",
    "@flowstate/mcp-canvas": "workspace:*",
    "@flowstate/mcp-gcal": "workspace:*",
    "@flowstate/mcp-gmail": "workspace:*",
    "@flowstate/mcp-system": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opencode-ai/sdk": "^1.1.20",
    "better-sqlite3": "^11.10.0",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "playwright": "^1.58.1",
    "pdf-parse": "^1.1.1",
    "shellwords": "^0.1.1",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/pdf-parse": "^1.1.4",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "lucide-react": "^0.312.0",
    "jszip": "^3.10.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.flowstate.app",
    "productName": "FlowState",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      {
        "from": "../mcp-gmail/dist",
        "to": "node_modules/@flowstate/mcp-gmail/dist"
      },
      {
        "from": "../mcp-gmail/package.json",
        "to": "node_modules/@flowstate/mcp-gmail/package.json"
      },
      {
        "from": "../mcp-gcal/dist",
        "to": "node_modules/@flowstate/mcp-gcal/dist"
      },
      {
        "from": "../mcp-gcal/package.json",
        "to": "node_modules/@flowstate/mcp-gcal/package.json"
      },
      {
        "from": "../mcp-system/dist",
        "to": "node_modules/@flowstate/mcp-system/dist"
      },
      {
        "from": "../mcp-system/package.json",
        "to": "node_modules/@flowstate/mcp-system/package.json"
      },
      {
        "from": "../mcp-canvas/dist",
        "to": "node_modules/@flowstate/mcp-canvas/dist"
      },
      {
        "from": "../mcp-canvas/package.json",
        "to": "node_modules/@flowstate/mcp-canvas/package.json"
      }
    ],
    "extraResources": [
      {
        "from": "../../agents",
        "to": "agents"
      },
      {
        "from": "../../workflows",
        "to": "workflows"
      },
      {
        "from": "../mcp-gmail/dist",
        "to": "mcp-servers/mcp-gmail/dist"
      },
      {
        "from": "../mcp-gcal/dist",
        "to": "mcp-servers/mcp-gcal/dist"
      },
      {
        "from": "../mcp-system/dist",
        "to": "mcp-servers/mcp-system/dist"
      },
      {
        "from": "../mcp-canvas/dist",
        "to": "mcp-servers/mcp-canvas/dist"
      },
      {
        "from": "vendor/opencode/darwin-arm64/opencode",
        "to": "bin/opencode-darwin-arm64"
      },
      {
        "from": "vendor/opencode/darwin-x64/opencode",
        "to": "bin/opencode-darwin-x64"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/flowstate-main-logo.icns",
      "category": "public.app-category.productivity"
    }
  }
}
