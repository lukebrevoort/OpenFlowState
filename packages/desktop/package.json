{
  "name": "@flowstate/desktop",
  "version": "0.1.0",
  "description": "FlowState Desktop App - AI-powered productivity orchestration",
  "author": "Luke Brevoort",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron dist/main/index.js",
    "preview": "npm run build && npm run start",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "clean": "rm -rf dist out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@flowstate/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opencode-ai/sdk": "^1.1.20",
    "pdf-parse": "^1.1.1",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/pdf-parse": "^1.1.4",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "lucide-react": "^0.312.0",
    "jszip": "^3.10.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.flowstate.app",
    "productName": "FlowState",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/flowstate-main-logo.png",
      "category": "public.app-category.productivity"
    }
  }
}
