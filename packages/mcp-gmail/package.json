{
  "name": "@flowstate/mcp-gmail",
  "version": "0.1.0",
  "description": "Gmail MCP server for FlowState - email reading, drafting, and sending",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-gmail": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flowstate/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "gcp-metadata": "^6.1.0",
    "googleapis": "^140.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "gmail",
    "email",
    "flowstate",
    "productivity"
  ],
  "license": "MIT"
}
